  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --detectOpenHandles --config ./jest.config.js",
    "test:setup": "node tests/db-init.js",
    "test:init": "npm run test:setup && npm test",
    "test:unit": "jest --testPathPattern=tests/unit --config ./jest.config.js",
    "test:integration": "jest --testPathPattern=tests/integration --config ./jest.config.js",
    "test:coverage": "jest --coverage --config ./jest.config.js",
    "db:init": "node tests/db-init.js"
  },
  "keywords": [],
